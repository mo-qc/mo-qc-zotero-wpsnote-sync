{
  "name": "zotero-wpsnote-sync",
  "type": "module",
  "version": "0.1.5",
  "description": "Sync Zotero items, notes, PDF links and annotations to WPS Notes via MCP",
  "config": {
    "addonName": "Zotero → WPS 笔记同步",
    "addonID": "zoterowpsnotesync@example.com",
    "addonRef": "zoterowpsnotesync",
    "addonInstance": "ZoteroWPSNoteSync",
    "prefsPrefix": "extensions.zotero.zoterowpsnotesync",
    "version": "0.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mo-qc/mo-qc-zotero-wpsnote-sync.git"
  },
  "author": "mo-qc",
  "bugs": {
    "url": "https://github.com/mo-qc/mo-qc-zotero-wpsnote-sync/issues"
  },
  "homepage": "https://github.com/mo-qc/mo-qc-zotero-wpsnote-sync#readme",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "node scripts/bump-version.mjs && zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "node scripts/bump-version.mjs && zotero-plugin release",
    "test": "zotero-plugin test",
    "test:unit": "tsx node_modules/mocha/bin/mocha.js test/*.test.ts",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
